{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "React Node posgress Application API",
    "description": "An API to demonstrate interaction with posgres database using node and react",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "host": "localhost:3001",
  "basePath": "/api/v1",
  "tags": [
    {
      "name": "Merchants",
      "description": "API for merchants in the system"
    }
  ],
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/merchants": {
      "post": {
        "tags": [
          "Merchants"
        ],
        "description": "Create new merchant in system",
        "parameters": [
          {
            "name": "merchant",
            "in": "body",
            "description": "Merchant that we want to create",
            "schema": {
              "$ref": "#/definitions/Merchant"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "A new merchant has been added: 'merchant details'",
            "schema": {
              "$ref": "#/definitions/Merchant"
            }
          }
        }
      },
      "get": {
        "tags": [
          "Merchants"
        ],
        "summary": "Get all merchants in the system",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Merchants"
            }
          }
        }
      }
    },
    "/merchants/{merchantId}": {
      "parameters": [
        {
          "name": "merchantId",
          "in": "path",
          "required": true,
          "description": "ID of merchant that we want to find",
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "Merchants"
        ],
        "summary": "Get merchant with given ID",
        "responses": {
          "200": {
            "description": "Merchant is found",
            "schema": {
              "$ref": "#/definitions/Merchant"
            }
          }
        }
      },
      "delete": {
        "summary": "Delete merchant with given ID",
        "tags": [
          "Merchants"
        ],
        "responses": {
          "200": {
            "description": "Merchant is deleted",
            "schema": {
              "$ref": "#/definitions/Merchant"
            }
          }
        }
      },
      "put": {
        "summary": "Update Merchant with give ID",
        "tags": [
          "Merchants"
        ],
        "parameters": [
          {
            "name": "merchant",
            "in": "body",
            "description": "Merchant with new values of properties",
            "schema": {
              "$ref": "#/definitions/Merchant"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Merchant is updated",
            "schema": {
              "$ref": "#/definitions/Merchant"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Merchant": {
      "required": [
        "email",
        "name"
      ],
      "properties": {
        "merchantId": {
          "type": "number"
        },
        "email": {
          "type": "string",
          "uniqueItems": true
        },
        "name": {
          "type": "string",
          "uniqueItems": true
        }
      }
    },
    "Merchants": {
      "type": "array",
      "$ref": "#/definitions/Merchant"
    }
  }
}